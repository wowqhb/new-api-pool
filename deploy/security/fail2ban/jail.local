[DEFAULT]
bantime = 24h
findtime = 1h
maxretry = 5
backend = systemd
banaction = ufw
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled = true
port = 23456
filter = sshd
maxretry = 3
findtime = 10m
bantime = 7d
logpath = %(sshd_log)s

[caddy-auth]
enabled = true
filter = caddy-auth
port = http,https
maxretry = 5
findtime = 10m
bantime = 1h
logpath = /var/log/caddy/admin.log

[new-api-auth]
enabled = true
filter = new-api-auth
port = http,https
maxretry = 10
findtime = 5m
bantime = 1h
logpath = /var/log/caddy/api.log
