# ═══════════════════════════════════════════════════════════
# New API 生产部署环境变量
# ═══════════════════════════════════════════════════════════
# 用法：
#   cp .env.example .env
#   bash scripts/gen-secrets.sh   # 自动填充所有 GENERATE_ME 字段
#   编辑域名/邮箱/管理员 IP 三项
#
# ⚠️  .env 包含所有密钥，绝对不要进 Git！.gitignore 已加。
# ═══════════════════════════════════════════════════════════

# ─── 镜像版本 ───
# 锁定版本而不是 latest，避免半夜被动升级出问题
NEW_API_VERSION=v0.13.1

# ─── 域名（必填）───
# 用户调用的 API 域名，例如 api.your-domain.com
API_DOMAIN=api.example.com
# 管理后台域名，必须和 API 域名分开（防止后台被扫）
ADMIN_DOMAIN=admin.example.com
# Let's Encrypt 注册邮箱，过期前会发提醒
ACME_EMAIL=admin@example.com

# ─── 管理后台访问控制（强烈建议配置）───
# 只有这些 CIDR 能访问 admin 域名。多个用空格分隔。
# 例：办公室固定 IP / 个人 VPN 出口 IP
# 不限制就填 0.0.0.0/0（不推荐生产）
ADMIN_ALLOW_CIDR=0.0.0.0/0

# ─── 数据库 ───
PG_USER=newapi
PG_DB=newapi
PG_LOG_DB=newapi_logs
PG_PASSWORD=GENERATE_ME

# ─── Redis ───
REDIS_PASSWORD=GENERATE_ME

# ─── new-api 安全密钥（生成后不要轻易改，否则用户全要重新登录）───
# 32+ 字符随机串，用于 session 加密
SESSION_SECRET=GENERATE_ME
# 32+ 字符随机串，用于上游 API Key 在数据库中加密存储
# ⚠️ 改了之后历史 Key 全部解密失败，渠道全废
CRYPTO_SECRET=GENERATE_ME

# ─── 节点类型（多实例必读）───
# 第一个实例固定 master，其它实例固定 slave
# new-api-1 在 compose 里已经写死 master，这里仅占位
NODE_TYPE=master

# ─── 备份配置 ───
# 备份保留天数
BACKUP_RETENTION_DAYS=30
# 备份加密密码（恢复时需要）
BACKUP_ENCRYPTION_PASSWORD=GENERATE_ME
# 远程备份目标（可选，留空则只本地）
# 支持 rclone 远程，先 rclone config 配好
RCLONE_REMOTE=
RCLONE_PATH=

# ─── Telegram 告警（可选，强烈建议配）───
# https://t.me/BotFather 创建 bot 拿 token
TG_BOT_TOKEN=
# 你自己/运维群的 chat_id，可用 @userinfobot 查
TG_CHAT_ID=

# ─── Grafana ───
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GENERATE_ME
